# =================================================================
# ResQHub Environment Variables Configuration
# Copy this file to .env and configure your local or cloud values
# =================================================================

# Server Port & Runtime Mode
PORT=5000
NODE_ENV=development

# Frontend Client URL (Configured for CORS validation)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/resqhub
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/resqhub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/resqhub

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Administrator Seeding Configuration (Used by 'npm run seed:admin')
ADMIN_NAME=ResQHub Administrator
ADMIN_EMAIL=admin@resqhub.org
ADMIN_PASSWORD=Admin@ResQHub2026
ADMIN_PHONE=9999999999
